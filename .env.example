# Copy to .env, which is gitignored. `npm run example:seller` and
# `npm run example:live` load it with node --env-file.

# Buyer wallet. Needs Base Sepolia USDC (0x036CbD53842c5426634e7929541eC2318f3dCF7e)
# and nothing else — the facilitator broadcasts and pays the gas.
EVM_PRIVATE_KEY=0x

# Buyer wallet for examples/live-solana.ts, as a base58 secret key — the format
# every Solana tool prints. Needs Solana devnet USDC
# (4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU) and nothing else; the
# facilitator signs as fee payer and pays the fee.
SVM_PRIVATE_KEY=

# Seller's receiving address, used by examples/seller-sepolia.ts.
# Must NOT be the address behind EVM_PRIVATE_KEY: the review server refuses a
# submission whose payer and payTo match, because paying yourself proves a
# transfer happened, not that a purchase did.
PAY_TO=0x

# The paid endpoint the buyer calls. seller-sepolia.ts serves this one locally.
# examples/live-solana.ts has no local seller to pair with, so running it means
# pointing this at an endpoint that actually quotes Solana devnet.
RESOURCE_URL=http://localhost:4021/weather

# Where labels are published and verified against their settlement.
REVIEW_ENDPOINT=https://x402-spend-reviews.g-764.workers.dev/v1/reviews
