{
  "name": "x402-spend",
  "version": "0.2.0",
  "description": "A bank statement for your agent's x402 spend, with the column the bank can't fill in: was it worth it.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "x402-spend": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --no-warnings --test \"dist/**/*.test.js\"",
    "report": "node --no-warnings dist/cli.js report"
  },
  "peerDependencies": {
    "@x402/core": ">=2.0.0",
    "@x402/fetch": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@x402/core": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "typescript": "^5.6.0"
  }
}
